# codegen/pretrain is TRACKED (skill libraries + the labeling pipeline are project content).
# Only its run artifacts are ignored -- a blanket ignore here silently hid the robotwin /
# embodiment adapters from the repo.
codegen/pretrain/pipeline/outputs/
codegen/pretrain/pipeline/*.log
codegen/pretrain/**/.nvinferencekeys

